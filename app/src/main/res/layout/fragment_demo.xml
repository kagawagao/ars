<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/theme_card"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ArsFragment 演示"
        android:textColor="@color/theme_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="此 Fragment 继承 ArsFragment，所有资源查询皆为换肤感知。\n切换皮肤后本区域自动更新。"
        android:textColor="@color/theme_text"
        android:textSize="14sp"
        android:paddingTop="8dp" />

    <TextView
        android:id="@+id/tvFragmentSkinStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/theme_accent"
        android:textSize="14sp"
        android:paddingTop="12dp"
        android:fontFamily="monospace" />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_launcher_foreground"
        android:tint="@color/theme_text" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:progress="75"
        android:progressTint="@color/theme_text" />

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fragment CheckBox"
        android:textColor="@color/theme_text"
        android:buttonTint="@color/theme_text"
        android:checked="true"
        android:layout_marginTop="8dp" />

</LinearLayout>
