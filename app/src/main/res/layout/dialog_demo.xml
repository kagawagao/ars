<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ArsDialogFragment 演示"
        android:textColor="@color/theme_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="此 DialogFragment 继承 ArsDialogFragment。\n皮肤切换时对话框内容自动更新。"
        android:textColor="@color/theme_text"
        android:textSize="14sp"
        android:paddingTop="8dp" />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_launcher_foreground"
        android:tint="@color/theme_text" />

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dialog CheckBox"
        android:textColor="@color/theme_text"
        android:buttonTint="@color/theme_text"
        android:checked="true"
        android:layout_marginTop="12dp" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:progress="50"
        android:progressTint="@color/theme_text" />

</LinearLayout>
